+++ b/wasm-deps/include/omp.h
@@ -0,0 +1,28 @@
+/* Single-threaded OpenMP runtime stub for WebAssembly builds of qiskit-aer.
+ * Emscripten has no OpenMP; without -fopenmp every `#pragma omp` is ignored,
+ * but some Aer headers still call the runtime API directly. */
+#ifndef AER_WASM_OMP_STUB_H
+#define AER_WASM_OMP_STUB_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline int omp_get_num_threads(void) { return 1; }
+static inline int omp_get_max_threads(void) { return 1; }
+static inline int omp_get_thread_num(void) { return 0; }
+static inline int omp_get_num_procs(void) { return 1; }
+static inline int omp_in_parallel(void) { return 0; }
+static inline int omp_get_nested(void) { return 0; }
+static inline int omp_get_max_active_levels(void) { return 1; }
+static inline int omp_get_level(void) { return 0; }
+static inline void omp_set_num_threads(int n) { (void)n; }
+static inline void omp_set_nested(int n) { (void)n; }
+static inline void omp_set_dynamic(int n) { (void)n; }
+static inline void omp_set_max_active_levels(int n) { (void)n; }
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
