# Build-time settings (set these in Cloudflare Pages > Settings > Environment variables).
# Canonical origin for canonical/og:url tags and the sitemap. No trailing slash.
SITE_URL=https://your-domain.example
# Google Analytics 4 measurement ID. Analytics is omitted when unset.
VITE_GA_ID=G-XXXXXXXXXX
# GitHub owner/repo that "New project from template" reads. Defaults to kriss-u/qisplay-templates.
# VITE_TEMPLATES_REPO=kriss-u/qisplay-templates
